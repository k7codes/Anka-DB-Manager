*:where(:not(.dosyaAlanı), :not([type=file])) {
    box-sizing: border-box;
}

:root {
    --arka: #0d0a09;
    --yuzey: #161210;
    --yuzey2: #1f1a17;
    --cizgi: #2a2320;
    --metin: #f2ece8;
    --soluk: #8f8480;
    --vurgu: #ff2d2d;
    --vurgu2: #ff5c5c;
    --vurgu2b: #ff7a6a;
    --mavi: #4b9fd6;
    --mavi2: #6fb3e0;
    --mavi2b: #9dccec;
    --cyan: #4b9fd6;
    --akim: var(--vurgu);
    --kirmiziAkis: var(--vurgu);
    --maviAkis: var(--mavi);
    --basari: #3fb37f;
    --uyari: #d69a3a;
    --hata: #ef4444;
    --fontAna: "Plus Jakarta Sans", "Segoe UI", system-ui, sans-serif;
    --fontSig: "Dancing Script", cursive;
}

html {
    margin: 0;
    padding: 0;
    background: var(--arka);
}

body {
    margin: 0;
    padding: 0;
    color: var(--metin);
    font-family: var(--fontAna);
    font-size: 14px;
    line-height: 1.55;
    cursor: url("imlec.png"), auto;
}

body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
        radial-gradient(50% 40% at 50% 100%, rgba(255, 45, 45, 0.10), transparent 62%),
        radial-gradient(45% 35% at 85% 0%, rgba(75, 159, 214, 0.05), transparent 60%);
}

a,
button,
.menüSimge,
.sekiSekmeler a {
    cursor: url("imlec.png") 4 4, pointer;
}

a {
    color: var(--vurgu);
    text-decoration: none;
}

code,
pre {
    font-family: Consolas, "Courier New", monospace;
}

.uygulama {
    display: flex;
    min-height: 100vh;
}

.kenarCubugu {
    width: 232px;
    min-width: 232px;
    background: rgba(10, 8, 10, 0.55);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    backdrop-filter: blur(18px) saturate(1.2);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    height: 100vh;
}

.kenarLogo {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 18px;
    border-bottom: 1px solid var(--cizgi);
}

.kenarLogo strong {
    font-size: 18px;
    letter-spacing: 0.3px;
    font-weight: 800;
    background: linear-gradient(120deg, #ffffff, var(--mavi2) 60%, var(--cyan));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.kenarLogo strong em {
    font-family: var(--fontSig);
    font-weight: 700;
    font-size: 23px;
    letter-spacing: 0;
    background: linear-gradient(120deg, var(--vurgu), #ffd24d);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-style: normal;
    text-shadow: 0 0 18px rgba(255, 210, 77, 0.35);
    margin-left: 3px;
}

.kenarLogo small {
    display: block;
    color: var(--soluk);
    font-size: 11px;
    font-family: var(--fontAna);
    letter-spacing: 0.4px;
    opacity: 0.85;
}

.logoIsaret {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--vurgu);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 18px;
    color: #fff;
}

.kenarMenü {
    padding: 14px 10px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1;
    overflow-y: auto;
}

.kenarMenü a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 9px;
    color: var(--soluk);
    font-weight: 500;
    transition: background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
}

.kenarMenü a:hover {
    background: var(--yuzey);
    color: var(--metin);
}

.kenarMenü a.aktif {
    background: rgba(255, 45, 45, 0.12);
    color: #fff;
    box-shadow: inset 3px 0 0 var(--vurgu);
}

.menüSimge {
    width: 16px;
    font-size: 15px;
    text-align: center;
    color: currentColor;
    opacity: 0.6;
}

.kenarMenü a.aktif .menüSimge {
    color: var(--vurgu2);
    opacity: 1;
}

.kenarAlt {
    padding: 14px;
    border-top: 1px solid var(--cizgi);
}

.cikisBağı {
    color: var(--hata);
    font-size: 13px;
}

.içerik {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.üstBar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 28px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(10, 8, 10, 0.45);
    position: sticky;
    top: 0;
    z-index: 5;
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    backdrop-filter: blur(16px) saturate(1.3);
}

.üstBaşlık {
    display: flex;
    align-items: center;
    gap: 10px;
}

.üstBaşlık h1 {
    margin: 0;
    font-size: 19px;
    font-weight: 600;
    color: var(--metin);
}

.sürümRozeti {
    font-size: 11px;
    padding: 3px 9px;
    border-radius: 6px;
    background: var(--yuzey2);
    border: 1px solid var(--cizgi);
    color: var(--soluk);
    letter-spacing: 0.3px;
}

.üstBilgi {
    display: flex;
    align-items: center;
    gap: 12px;
}

.bağlantıRozeti {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    padding: 6px 12px;
    border-radius: 6px;
    background: var(--yuzey2);
    border: 1px solid var(--cizgi);
    color: var(--metin);
}

.bağlantıRozeti i,
.kullanıcıAdı i,
.cikisBağı i {
    font-size: 12px;
    opacity: 0.85;
}

.bağlantıYok {
    color: var(--hata);
}

.durumNoktası {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--basari);
}

.kullanıcıAdı {
    color: var(--soluk);
    font-size: 13px;
}

.canliSaat {
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
    color: var(--mavi2);
    padding: 6px 11px;
    border: 1px solid var(--cizgi);
    border-radius: 6px;
    background: var(--yuzey2);
    letter-spacing: 1px;
}

.sayfaAlani {
    flex: 1;
    padding: 24px 26px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    animation: sayfaGecis 0.2s ease;
}

@keyframes sayfaGecis {
    from { opacity: 0; }
    to { opacity: 1; }
}

/* .girisFade artık ek bir efekt uygulamıyor; sınıf adı geriye dönük uyumluluk için HTML'de kalabilir */
.sayfaAlani.girisFade > * {
    animation: none;
}

.altÇizgi {
    padding: 14px 26px;
    border-top: 1px solid var(--cizgi);
    color: var(--soluk);
    font-size: 12px;
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    align-items: center;
}

.altÇizgi i {
    margin-right: 5px;
    color: var(--vurgu);
}

.kart {
    position: relative;
    background: var(--yuzey);
    border: 1px solid var(--cizgi);
    border-radius: 10px;
    padding: 18px 20px;
    overflow: hidden;
    transition: border-color 0.15s ease;
}

.kart:hover {
    border-color: rgba(92, 200, 255, 0.35);
    box-shadow:
        0 16px 44px rgba(0, 0, 0, 0.6),
        0 0 0 1px rgba(45, 166, 255, 0.06),
        0 0 34px rgba(45, 166, 255, 0.14);
    transform: translateY(-2px);
}

.kart > .bildirim + .buton,
.kart > .bildirim + p,
.kart > .bildirim + .butonAna {
    margin-top: 14px;
}

.kart > .buton + .buton {
    margin-left: 8px;
}

.kartBaşlık {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 14px;
}

.kartBaşlık h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.2px;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(120deg, var(--metin), var(--mavi2) 75%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.kartBaşlık h3 i {
    background: linear-gradient(120deg, var(--mavi), var(--vurgu));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-size: 15px;
    color: initial;
}

.kartBaşlık h3 small {
    color: var(--soluk);
    font-weight: 400;
    font-size: 12px;
    -webkit-text-fill-color: currentColor;
    background: none;
}

.kartEylemler {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

.küçükNot {
    color: var(--soluk);
    font-size: 12.5px;
}

.kartİçi {
    padding: 6px 4px;
}

.kartRakam {
    font-size: 30px;
    font-weight: 700;
    color: var(--metin);
    display: flex;
    align-items: center;
    gap: 8px;
}

.kartRakam i {
    font-size: 22px;
    -webkit-text-fill-color: var(--vurgu);
    color: var(--vurgu);
}

.kartEtiket {
    color: var(--soluk);
    font-size: 12.5px;
}

.kartAlt {
    color: var(--soluk);
    font-size: 11.5px;
    margin-top: 4px;
    border-top: 1px dashed rgba(43, 26, 26, 0.7);
    padding-top: 6px;
    opacity: 0.75;
}

.ızgaraDört {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
}

.ızgaraİki {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    align-items: start;
}

.bildirim {
    padding: 11px 40px 11px 14px;
    border-radius: 10px;
    font-size: 13.5px;
    border: 1px solid transparent;
    position: relative;
    animation: bildirimGiris 0.35s ease;
    transition: opacity 0.3s ease, transform 0.3s ease;
}

@keyframes bildirimGiris {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
}

.bildirimKapanis {
    opacity: 0;
    transform: translateY(-8px);
}

.bildirimKapat {
    position: absolute;
    top: 50%;
    right: 10px;
    transform: translateY(-50%);
    cursor: pointer;
    opacity: 0.6;
    font-size: 12px;
    padding: 3px;
    border-radius: 4px;
    transition: opacity 0.15s ease, color 0.15s ease;
}

.bildirimKapat:hover {
    opacity: 1;
    color: #fff;
}

.bildirim-bilgi {
    background: rgba(255, 45, 45, 0.12);
    border-color: rgba(255, 45, 45, 0.4);
    color: #ffcdcd;
}

.bildirim-hata {
    background: rgba(255, 45, 45, 0.2);
    border-color: rgba(255, 45, 45, 0.55);
    color: #ffb8bd;
}

.bildirim-basarı {
    background: rgba(47, 214, 122, 0.12);
    border-color: rgba(47, 214, 122, 0.4);
    color: #b8ffd6;
}

.bildirim-uyari,
.bildirim-uyarı {
    background: rgba(255, 194, 75, 0.12);
    border-color: rgba(255, 194, 75, 0.4);
    color: #ffe3a8;
}

.tabloSarıcı {
    overflow-x: auto;
    border-radius: 10px;
    border: 1px solid var(--cizgi);
}

.veriTablo {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
}

.veriTablo th {
    text-align: left;
    background: var(--yuzey2);
    padding: 9px 12px;
    color: var(--soluk);
    font-weight: 600;
    font-size: 12px;
    white-space: nowrap;
    border-bottom: 1px solid var(--cizgi);
}

.veriTablo td {
    padding: 8px 12px;
    border-bottom: 1px solid rgba(43, 26, 26, 0.6);
    vertical-align: top;
    word-break: break-word;
}

.veriTablo tr:last-child td {
    border-bottom: none;
}

.veriTablo tbody tr:hover {
    background: rgba(20, 13, 13, 0.75);
}

.anahtar {
    color: var(--uyari);
    font-size: 10px;
    border: 1px solid var(--uyari);
    border-radius: 4px;
    padding: 0 4px;
}

.null {
    color: var(--uyari);
    font-style: italic;
    opacity: 0.7;
}

.hizalıSağ {
    text-align: right;
}

.boşMesaj {
    text-align: center;
    color: var(--soluk);
    padding: 26px !important;
}

.buton {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 13px;
    border-radius: 7px;
    background: var(--yuzey2);
    border: 1px solid var(--cizgi);
    color: var(--metin);
    font-size: 13px;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
    font-family: inherit;
    text-decoration: none;
    justify-content: center;
}

.buton:hover {
    border-color: #3a2f2b;
    background: #241d19;
}

.butonAna {
    background: linear-gradient(120deg, var(--vurgu), var(--vurgu2) 50%, var(--mavi));
    background-size: 200% 100%;
    border: none;
    color: #fff;
    font-weight: 600;
    position: relative;
    overflow: hidden;
    transition: background-position 0.35s ease, box-shadow 0.25s ease, transform 0.15s ease;
}

.butonAna::after {
    content: "";
    position: absolute;
    top: 0;
    left: -120%;
    width: 60%;
    height: 100%;
    background: linear-gradient(105deg, transparent, rgba(255, 255, 255, 0.35), transparent);
    transform: skewX(-20deg);
    transition: left 0.5s ease;
    pointer-events: none;
}

.butonAna:hover {
    background-position: 100% 0;
    box-shadow: 0 6px 22px rgba(255, 45, 90, 0.35), 0 0 0 1px rgba(255, 255, 255, 0.06);
    transform: translateY(-1px);
}

.butonAna:hover::after {
    left: 140%;
}

.butonAna:active {
    transform: translateY(0) scale(0.98);
}

.butonKirmizi {
    background: var(--vurgu);
    border: none;
    color: #fff;
    font-weight: 600;
}

.butonMavi {
    background: linear-gradient(120deg, var(--mavi), var(--cyan));
    border: none;
    color: #fff;
    font-weight: 600;
    transition: box-shadow 0.2s ease, transform 0.15s ease;
}

.butonMavi:hover {
    box-shadow: 0 4px 18px rgba(45, 166, 255, 0.4);
    transform: translateY(-1px);
}

.butonKirmizi {
    background: linear-gradient(120deg, var(--vurgu), var(--vurgu2));
    border: none;
    color: #fff;
    font-weight: 600;
    transition: box-shadow 0.2s ease, transform 0.15s ease;
}

.butonKirmizi:hover {
    box-shadow: 0 4px 18px rgba(255, 45, 45, 0.4);
    transform: translateY(-1px);
}

.butonTehlikeli {
    color: var(--hata);
}

.butonTehlikeli:hover {
    background: rgba(255, 45, 45, 0.14);
}

.butonKüçük {
    padding: 4px 10px;
    font-size: 12px;
}

.satırİçiForm {
    display: inline-block;
}

.satırİçiForm + .satırİçiForm {
    margin-left: 8px;
}

.satırGeniş {
    display: flex;
    gap: 8px;
    align-items: center;
}

.metinAlanı {
    background: var(--arka);
    border: 1px solid var(--cizgi);
    color: var(--metin);
    border-radius: 8px;
    padding: 8px 11px;
    font-family: inherit;
    font-size: 13.5px;
    min-width: 240px;
}

.metinAlanı:focus,
input:focus,
select:focus,
textarea:focus {
    outline: none;
    border-color: var(--vurgu);
    box-shadow: 0 0 0 3px rgba(255, 45, 45, 0.20);
}

.alan {
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-size: 12.5px;
    color: var(--soluk);
}

.alan small {
    opacity: 0.8;
}

.alan input,
.alan select,
.alan textarea {
    background: rgba(12, 9, 12, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
    color: var(--metin);
    padding: 9px 12px;
    font-family: inherit;
    font-size: 13.5px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
}

.alan input:focus,
.alan select:focus,
.alan textarea:focus {
    outline: none;
    border-color: var(--vurgu);
    background: rgba(16, 12, 16, 0.75);
    box-shadow: 0 0 0 3px rgba(255, 45, 45, 0.15);
}

.alanDar {
    max-width: 110px;
}

.alanBüyük input {
    padding: 11px 13px;
    font-size: 14px;
}

.alanSatırı {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
}

.formIzgara {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
}

.formEylemler {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-top: 6px;
    grid-column: 1 / -1;
}

.işaretle {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--metin);
    cursor: pointer;
}

.işaretListesi {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-bottom: 14px;
}

.rozet {
    font-size: 11px;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(47, 214, 122, 0.14);
    color: var(--basari);
    border: 1px solid rgba(47, 214, 122, 0.4);
}

.sayfalama {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
    color: var(--soluk);
    font-size: 12.5px;
}

.sayfaBağları {
    display: flex;
    gap: 6px;
}

.sekiSırası {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
}

.geriBağ {
    margin-right: auto;
}

.sekiSekmeler {
    display: inline-flex;
    background: var(--yuzey);
    border: 1px solid var(--cizgi);
    border-radius: 10px;
    overflow: hidden;
}

.sekiSekmeler a {
    padding: 8px 20px;
    color: var(--soluk);
    font-size: 13px;
}

.sekiSekmeler a.aktif {
    background: var(--vurgu);
    color: #fff;
    font-weight: 600;
}

.sekiEylemler {
    display: flex;
    gap: 10px;
    align-items: center;
}

.konsolAlan {
    width: 100%;
    background: var(--arka);
    color: #f0d8d0;
    border: 1px solid var(--cizgi);
    border-radius: 8px;
    padding: 14px;
    font-family: Consolas, "Courier New", monospace;
    font-size: 13.5px;
    resize: vertical;
    tab-size: 4;
    caret-color: var(--vurgu);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.konsolAlan:focus {
    outline: none;
    border-color: var(--vurgu);
    box-shadow: 0 0 0 3px rgba(255, 45, 45, 0.12);
}

.sqlÖnizleme {
    font-size: 12.5px;
    color: var(--vurgu);
    word-break: break-all;
    white-space: pre-wrap;
}

.konsolSonuç {
    max-height: 420px;
    overflow-y: auto;
}

.sorguGecmis {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.gecmisOnge {
    text-align: left;
    background: var(--yuzey2);
    border: 1px solid var(--cizgi);
    color: var(--metin);
    border-radius: 8px;
    padding: 8px 12px;
    font-family: inherit;
    font-size: 12.5px;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.1s ease;
}

.gecmisOnge:hover {
    border-color: var(--vurgu);
    background: rgba(255, 45, 45, 0.08);
    transform: translateX(2px);
}

.gecmisOnge code {
    color: var(--vurgu);
    font-size: 12px;
}

.ornekCipleri {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 10px;
}

.cipler {
    background: var(--yuzey2);
    border: 1px solid var(--cizgi);
    color: var(--soluk);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 11.5px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
    font-family: inherit;
}

.cipler:hover {
    border-color: var(--vurgu);
    color: var(--metin);
    background: rgba(255, 45, 45, 0.08);
}

.bağlantıListesi {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.bağlantıKartı {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 13px;
    background: var(--yuzey2);
    border: 1px solid var(--cizgi);
    border-radius: 10px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.bağlantıKartı:hover {
    border-color: rgba(255, 45, 45, 0.5);
}

.bağlantıKartı.seçili {
    border-color: var(--vurgu);
    box-shadow: 0 0 0 2px rgba(255, 45, 45, 0.18);
}

.bağlantıBilgi {
    display: flex;
    flex-direction: column;
}

.bağlantıBilgi small {
    color: var(--soluk);
    font-size: 12px;
}

.surucuIkon {
    color: var(--vurgu);
    font-size: 13px;
    margin-right: 6px;
}

.bağlantıBilgi strong i:first-child {
    color: var(--vurgu);
}

.bağlantıİşlemler {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
}

.hızlıBağlantılar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
}

.hızlı {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px;
    border: 1px solid var(--cizgi);
    border-radius: 12px;
    background: var(--yuzey2);
    color: var(--metin);
    font-weight: 600;
    font-size: 13.5px;
    transition: border-color 0.15s ease, transform 0.1s ease, box-shadow 0.15s ease;
}

.hızlı:hover {
    border-color: var(--vurgu);
}

.hızlı i {
    font-size: 15px;
    color: var(--vurgu);
    margin-bottom: 2px;
    transition: transform 0.2s ease;
    width: 18px;
}

.hızlı:hover i {
    transform: translateX(4px);
}

.hızlı small {
    color: var(--soluk);
    font-weight: 400;
    font-size: 12px;
}

.bilgiListesi {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.bilgiListesi li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(43, 26, 26, 0.5);
    color: var(--soluk);
}

.bilgiListesi li:last-child {
    border-bottom: none;
}

.olguİyi { color: var(--basari); }
.olguKötü { color: var(--hata); }

.yönergeler {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--soluk);
}

.yönergeler strong {
    color: var(--metin);
}

.yönergeler code {
    color: var(--vurgu);
}

.işlemKayıtları {
    display: flex;
    flex-direction: column;
    gap: 7px;
    max-height: 360px;
    overflow-y: auto;
}

.işlemKaydı {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--yuzey2);
    font-size: 13px;
    border-left: 3px solid var(--vurgu);
}

.işlem-hata { border-left-color: var(--hata); }
.işlem-uyari { border-left-color: var(--uyari); }
.işlem-yol { border-left-color: var(--basari); }

.zaman {
    color: var(--soluk);
    font-size: 11px;
    min-width: 58px;
}

.blokNot {
    display: block;
    margin: 10px 0 0;
}

.girişKutusu {
    max-width: 360px;
    margin: 9vh auto 0;
    background: var(--yuzey);
    border: 1px solid var(--cizgi);
    border-radius: 12px;
    padding: 28px;
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.4);
}

.girişLogo {
    font-size: 22px;
    font-weight: 800;
    text-align: center;
    margin-bottom: 20px;
}

.girişLogo > i {
    margin-right: 6px;
    color: var(--vurgu);
}

.girişLogo span {
    color: var(--vurgu);
}

.girişNot {
    margin: 4px 0 0;
    text-align: center;
    font-size: 11.5px;
    opacity: 0.8;
}

.girişNot i {
    color: var(--vurgu);
    margin-right: 4px;
}

.girişForm {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

/* kurulum */
.kurulumSayfasi {
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 40px 16px;
}

.kurulumKutusu {
    width: 100%;
    max-width: 460px;
    background: var(--yuzey);
    border: 1px solid var(--cizgi);
    border-radius: 14px;
    padding: 30px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
}

.kurulumLogo {
    text-align: center;
    margin-bottom: 22px;
}

.kurulumLogo .logoIsaret {
    width: 56px;
    height: 56px;
    font-size: 26px;
}

.kurulumLogo h1 {
    margin: 12px 0 2px;
    font-size: 22px;
}

.kurulumLogo h1 span {
    color: var(--vurgu);
}

.kurulumLogo p {
    margin: 0;
    color: var(--soluk);
    font-size: 13px;
}

.kurulumForm {
    display: flex;
    flex-direction: column;
    gap: 13px;
}

.kurulumForm .kartBaslik,
.kartBaslik {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--vurgu);
    margin-top: 6px;
    padding-bottom: 6px;
    border-bottom: 1px dashed rgba(255, 45, 45, 0.35);
}

.kurulumForm .kartBaslik:first-child {
    margin-top: 0;
}

.kurulumForm .butonAna {
    margin-top: 6px;
    width: 100%;
}

.kartBaşlık + .kartBaşlık {
    margin-top: 12px;
}

.formIzgara .alan:nth-last-child(2) {
    grid-column: 1 / -1;
}

.dosyaAlanı {
    color: var(--soluk);
    font-size: 13px;
    box-sizing: border-box;
    display: block;
    width: 100%;
    padding: 18px 14px;
    border: 1.5px dashed rgba(92, 200, 255, 0.35);
    border-radius: 12px;
    background:
        radial-gradient(120% 100% at 0% 0%, rgba(45, 166, 255, 0.10), transparent 55%),
        rgba(10, 15, 24, 0.4);
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    text-align: center;
    font-family: var(--fontAna);
}

.dosyaAlanı::file-selector-button {
    background: linear-gradient(120deg, var(--mavi), var(--cyan));
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    margin-right: 12px;
    cursor: pointer;
    transition: box-shadow 0.2s ease, transform 0.15s ease;
}

.dosyaAlanı::file-selector-button:hover {
    box-shadow: 0 4px 16px rgba(45, 166, 255, 0.4);
    transform: translateY(-1px);
}

.dosyaAlanı:hover {
    border-color: rgba(45, 166, 255, 0.7);
    background:
        radial-gradient(120% 120% at 0% 0%, rgba(45, 166, 255, 0.18), transparent 60%),
        rgba(10, 15, 24, 0.5);
    box-shadow: 0 0 22px rgba(45, 166, 255, 0.18);
}

.dosyaAlanı:focus-within {
    outline: none;
    border-color: var(--mavi);
    box-shadow: 0 0 0 3px rgba(45, 166, 255, 0.18), 0 0 24px rgba(45, 166, 255, 0.2);
}

.manzaraKart {
    padding: 0;
    overflow: hidden;
}

.manzaraKart .kartBaşlık {
    padding: 16px 20px 6px;
    margin-bottom: 0;
}

.manzaraKonteynır {
    position: relative;
    height: 470px;
    border-radius: 0 0 14px 14px;
    overflow: hidden;
    border-top: 1px solid var(--cizgi);
    margin-top: 12px;
}

.manzaraKonteynır canvas {
    display: block;
    width: 100%;
    height: 100%;
}

.manzaraHud {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    pointer-events: none;
    z-index: 2;
}

.hudEtiket,
.hudDurum {
    background: rgba(8, 6, 6, 0.72);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    border: 1px solid rgba(255, 45, 45, 0.4);
    color: var(--soluk);
    font-size: 12px;
    padding: 6px 12px;
    border-radius: 20px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.hudEtiket b {
    color: var(--vurgu2);
    font-weight: 800;
}

.hudDurum i {
    color: var(--vurgu2);
}

.manzaraKart .bildirim {
    margin: 14px 20px 0;
}

.kanvasKart {
    padding: 0 0 0 0;
    overflow: hidden;
}

.kanvasKart .kartBaşlık {
    padding: 16px 20px 6px;
    margin-bottom: 0;
}

.canvasKonteynır,
.kanvasKonteynır {
    position: relative;
    height: 460px;
    border-radius: 0 0 14px 14px;
    overflow: hidden;
    border-top: 1px solid var(--cizgi);
    margin-top: 12px;
}

.kanvasKonteynır canvas {
    display: block;
    width: 100%;
    height: 100%;
}

.kanvasBos {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--soluk);
    font-size: 14px;
    gap: 6px;
}

.kanvasBos i {
    font-size: 40px;
    color: var(--vurgu2);
    margin-bottom: 8px;
}

.kanvasHud {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    pointer-events: none;
}

.kanvasKart .satırİçiForm {
    margin-bottom: 4px;
}

.kanvasÖrnekler {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 4px 20px 6px;
}

.kanvasÖrnekler .küçükNot {
    color: var(--mavi2);
    opacity: 0.9;
}

.kanvasÖrnekler .cipler {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    font-size: 12px;
    border-radius: 999px;
    background: rgba(45, 166, 255, 0.10);
    border: 1px solid rgba(45, 166, 255, 0.32);
    color: var(--mavi2);
    text-decoration: none;
    transition: background 0.15s ease, box-shadow 0.15s ease;
}

.kanvasÖrnekler .cipler:hover {
    background: rgba(45, 166, 255, 0.2);
    box-shadow: 0 0 16px rgba(45, 166, 255, 0.3);
}

.kanvasBos small {
    color: var(--soluk);
    opacity: 0.7;
}

.kanvasHudSayi,
.kanvasHudKaynak {
    display: inline-block;
    padding: 4px 11px;
    font-size: 12px;
    border-radius: 999px;
    font-family: Consolas, monospace;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(92, 200, 255, 0.2);
    background: rgba(8, 14, 22, 0.55);
}

.kanvasHudOrnek {
    display: inline-block;
    padding: 4px 11px;
    font-size: 12px;
    border-radius: 999px;
    font-family: Consolas, monospace;
    color: #ffd24d;
    border: 1px solid rgba(255, 210, 77, 0.35);
    background: rgba(40, 30, 8, 0.55);
    text-shadow: 0 0 10px rgba(255, 210, 77, 0.5);
}

.kanvasDetay {
    flex: 1 1 100%;
    padding: 12px 16px;
    border: 1px solid rgba(92, 200, 255, 0.22);
    border-radius: 12px;
    background:
        radial-gradient(120% 100% at 0% 0%, rgba(45, 166, 255, 0.12), transparent 55%),
        rgba(8, 13, 21, 0.6);
    font-family: Consolas, monospace;
    font-size: 12.5px;
    line-height: 1.7;
    animation: bildirimGir 0.25s ease both;
}

.kanvasDetayAd {
    font-family: var(--fontAna);
    margin-bottom: 8px;
    color: var(--mavi2);
}

.kanvasDetayAd b {
    color: #fff;
    background: linear-gradient(120deg, var(--mavi), var(--vurgu));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.kanvasDetayAd small {
    color: var(--soluk);
    font-weight: 400;
}

.kanvasDetayKip {
    color: var(--metin);
    word-break: break-word;
}

.kanvasHudSayi {
    color: #6fdcff;
}

.kanvasHudKaynak {
    color: var(--mavi2);
}

.kanvasAlan {
    display: flex;
    gap: 16px;
    padding: 0 18px 18px;
    align-items: stretch;
    flex-wrap: wrap;
}

.kanvasAlan .kanvasKonteynır {
    flex: 1 1 440px;
    margin-top: 0;
    border-radius: 12px;
    min-height: 400px;
    height: auto;
}

.kanvasTablo {
    flex: 0 1 320px;
    max-height: 400px;
    overflow: auto;
    border: 1px solid var(--cizgi);
    border-radius: 12px;
    background: rgba(10, 15, 24, 0.5);
    padding: 12px;
}

.kanvasTabloBaşlık {
    font-size: 12px;
    color: var(--mavi2);
    margin-bottom: 8px;
    letter-spacing: 0.3px;
}

.kanvasTablo .veriTablo {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    font-family: Consolas, monospace;
}

.kanvasTablo .veriTablo th {
    position: sticky;
    top: 0;
    background: rgba(10, 15, 24, 0.96);
    color: var(--mavi2);
    text-align: left;
    padding: 6px 8px;
    border-bottom: 1px solid rgba(92, 200, 255, 0.2);
    z-index: 1;
}

.kanvasTablo .veriTablo td {
    padding: 5px 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--metin);
    white-space: nowrap;
}

.kanvasTablo .veriTablo tbody tr:hover td {
    background: rgba(45, 166, 255, 0.08);
}

.kanvasKontroller {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 10px 20px 6px;
    align-items: flex-end;
}

.kanvasKontrol {
    display: inline-flex;
    flex-direction: column;
    gap: 5px;
    font-size: 11px;
    color: var(--soluk);
    letter-spacing: 0.3px;
}

.kanvasKontrol select {
    background: rgba(12, 18, 28, 0.85);
    color: var(--mavi2);
    border: 1px solid rgba(45, 166, 255, 0.35);
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 13px;
    font-family: Consolas, monospace;
    outline: none;
}

.kanvasKontrol select:focus {
    border-color: var(--mavi);
    box-shadow: 0 0 0 3px rgba(45, 166, 255, 0.15);
}

.kanvasKontrol .bos {
    visibility: hidden;
}

.gizli {
    display: none !important;
}

.kanvasKonteynır .hudEtiket b {
    color: var(--mavi2);
}

.zeugerKart {
    padding: 0;
    overflow: hidden;
}

.zeugerKart .kartBaşlık {
    padding: 16px 20px 6px;
    margin-bottom: 0;
}

.zeugerKart .kartBaşlık em {
    font-style: normal;
    color: var(--mavi2);
    font-weight: 400;
    font-size: 12px;
}

.zeugerÜst {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 6px 20px 10px;
    flex-wrap: wrap;
}

.zeugerKontroller {
    display: inline-flex;
    gap: 8px;
}

.zeugerSecici {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--soluk);
}

.zeugerSecici select {
    background: rgba(12, 18, 28, 0.85);
    color: var(--mavi2);
    border: 1px solid rgba(45, 166, 255, 0.35);
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 13px;
    font-family: Consolas, monospace;
    outline: none;
}

.zeugerSecici select:focus {
    border-color: var(--mavi);
    box-shadow: 0 0 0 3px rgba(45, 166, 255, 0.15);
}

.zeugerİstatistik {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    color: var(--soluk);
    font-size: 12px;
    font-family: Consolas, monospace;
    flex-wrap: wrap;
}

.zeugerİstatistik span {
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(12, 18, 26, 0.6);
    border: 1px solid rgba(92, 200, 255, 0.18);
}

.zeugerİstatistik b {
    color: var(--mavi2);
    font-weight: 600;
    margin-left: 2px;
}

.zeugerKonteynır {
    position: relative;
    height: 400px;
    border-top: 1px solid var(--cizgi);
    overflow: hidden;
    background: #060404;
}

.zeugerKonteynır canvas {
    display: block;
    width: 100%;
    height: 100%;
}

/* ---- dinamik ambiyans & signature dokunuşlar ---- */

/* kartlara yumuşak giriş animasyonu */
.sayfaAlani > .kart {
    animation: kartGiris 0.5s ease both;
}

.sayfaAlani > .kart:nth-child(2) { animation-delay: 0.05s; }
.sayfaAlani > .kart:nth-child(3) { animation-delay: 0.1s; }
.sayfaAlani > .kart:nth-child(4) { animation-delay: 0.15s; }

@keyframes kartGiris {
    from {
        opacity: 0;
        transform: translateY(14px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* tablo satır hover: sol neon çubuk + satır parlaması */
.veriTablo tbody tr {
    transition: background 0.15s ease;
}

.veriTablo tbody tr:hover {
    background: linear-gradient(90deg, rgba(45, 166, 255, 0.14), rgba(45, 166, 255, 0.03) 30%, transparent);
    box-shadow: inset 3px 0 0 rgba(45, 166, 255, 0.7), inset 600px 0 40px -30px rgba(45, 166, 255, 0.06);
}

/* signature font odak: bazı mikro etiketler + değer sayıları */
.sürümRozeti,
.hudEtiket i,
.küçükNot i,
.istatistikBüyük b,
.istatistikOrta b {
    text-shadow: 0 0 12px rgba(111, 219, 255, 0.5);
}

.küçükNot {
    font-family: var(--fontAna);
    font-size: 12px;
    letter-spacing: 0.2px;
    color: var(--soluk);
    opacity: 0.9;
}

/* üst başlık altına kayan gradient çizgi */
.üstBar::after {
    content: "";
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--mavi) 30%, var(--vurgu) 60%, transparent);
    opacity: 0.45;
    animation: çizgiAkış 6s linear infinite;
    background-size: 200% 100%;
}

@keyframes çizgiAkış {
    from { background-position: 0% 0; }
    to { background-position: 200% 0; }
}

/* kenar çubuğu aktif linke parlayan sol şerit */
.kenarMenü a.aktif::before {
    animation: kenarParlama 2.4s ease-in-out infinite;
}

@keyframes kenarParlama {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
}

/* üst başlık altına kayan gradient çizgi */
.bildirim {
    animation: bildirimGir 0.3s ease both;
}

@keyframes bildirimGir {
    from {
        opacity: 0;
        transform: translateX(12px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@media (max-width: 900px) {
    .ızgaraDört,
    .ızgaraİki,
    .formIzgara {
        grid-template-columns: 1fr;
    }

    .kenarCubugu {
        width: 64px;
        min-width: 64px;
    }

    .kenarLogo strong,
    .kenarLogo small,
    .kenarMenü a span:last-child,
    .kenarAlt a {
        display: none;
    }

    .kenarMenü a {
        justify-content: center;
    }
}